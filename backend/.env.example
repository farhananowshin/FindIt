# Backend Server Port
PORT=5000

# MongoDB Connection String (Replace with your local URI or MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/findit

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://localhost:8001

# Node Environment
NODE_ENV=development

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Account Seed Configuration
ADMIN_NAME=Campus Security Admin
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_STUDENT_ID=ADMIN-001
ADMIN_PHONE=+1 (555) 019-9000
