# FindIt Docker Compose Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ── JWT & Admin ──────────────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_jwt_secret_here_min_32_chars
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_EMAIL=admin@your-domain.com

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your_32_char_minimum_encryption_key_here

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/findit

# ── External Services ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://ai-service:8001
